{
  "name": "@hiisi/otso",
  "version": "0.1.1",
  "description": "Build one TypeScript codebase into deno, node and bun distributions, stripping what each runtime does not need.",
  "license": "MPL-2.0",
  "exports": {
    ".": "./mod.ts",
    "./cli": "./cli.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.0",
    "@hiisi/ft-flags": "jsr:@hiisi/ft-flags@^0.2.0",
    "@hiisi/tgts": "jsr:@hiisi/tgts@^0.2.0",
    "@hiisi/cfg-ts": "jsr:@hiisi/cfg-ts@^0.1.0",
    "@hiisi/deno-dist": "jsr:@hiisi/deno-dist@^0.4.0",
    "@hiisi/shimp": "jsr:@hiisi/shimp@^0.1.0",
    "@hiisi/viola": "jsr:@hiisi/viola@^0.3.1",
    "@hiisi/viola-default-lints": "jsr:@hiisi/viola-default-lints@^0.3.1",
    "@hiisi/viola-grammar-ts": "jsr:@hiisi/viola-grammar-ts@^0.3.1"
  },
  "lint": {
    "include": [
      "**/*.ts"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "camelcase",
        "default-param-last",
        "eqeqeq",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "no-await-in-loop",
        "no-console",
        "no-const-assign",
        "no-eval",
        "no-implicit-declare-namespace-export",
        "no-non-null-asserted-optional-chain",
        "no-self-compare",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "prefer-ascii",
        "single-var-declarator",
        "verbatim-module-syntax"
      ],
      "exclude": [
        "no-console"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "include": [
      "**/*.ts",
      "*.md"
    ]
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env --allow-run --allow-net tests/",
    "test:watch": "deno test --allow-read --allow-write --allow-env --allow-run --allow-net --watch tests/",
    "lint": "deno run -A --min-dep-age=0 jsr:@hiisi/viola-cli@^0.3.1 --project . --include .",
    "lint:fix": "deno lint --fix",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check mod.ts cli.ts",
    "all": "deno task fmt && deno task lint && deno task check && deno task test",
    "prepublish": "deno task all"
  },
  "publish": {
    "include": [
      "mod.ts",
      "cli.ts",
      "src/**/*.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "tests/",
      "examples/",
      "scripts/",
      ".githooks/"
    ]
  },
  "repository": "https://github.com/hiisi-digital/otso",
  "links": [
    "../tgts",
    "../ft-flags",
    "../cfg-ts",
    "../deno-dist",
    "../shimp",
    "../onlywhen"
  ],
  "minimumDependencyAge": 0
}
