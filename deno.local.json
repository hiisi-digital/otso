{
  "links": [
    "../tgts",
    "../ft-flags",
    "../cfg-ts",
    "../deno-dist"
  ],
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.0",
    "@hiisi/ft-flags": "jsr:@hiisi/ft-flags@^0.2.0",
    "@hiisi/tgts": "jsr:@hiisi/tgts@^0.2.0",
    "@hiisi/cfg-ts": "jsr:@hiisi/cfg-ts@^0.1.0",
    "@hiisi/deno-dist": "jsr:@hiisi/deno-dist@^0.3.1",
    "@hiisi/deno-dist/cli": "../deno-dist/src/cli.ts",
    "@hiisi/shimp": "../shimp/mod.ts"
  },
  "lint": {
    "include": [
      "**/*.ts"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "camelcase",
        "default-param-last",
        "eqeqeq",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "no-await-in-loop",
        "no-console",
        "no-const-assign",
        "no-eval",
        "no-implicit-declare-namespace-export",
        "no-non-null-asserted-optional-chain",
        "no-self-compare",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "prefer-ascii",
        "single-var-declarator",
        "verbatim-module-syntax"
      ],
      "exclude": [
        "no-console"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "include": [
      "**/*.ts",
      "*.md"
    ]
  }
}
